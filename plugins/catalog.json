{
  "schema_version": 1,
  "plugins": [
    {
      "schema_version": 1,
      "id": "com.kosmos.dictation",
      "name": "Диктовка",
      "summary": "Речь в текст по горячей клавише: расшифровка на облаке или локально и вставка в активное окно.",
      "source": {
        "kind": "release",
        "repository": "makekosmos/dictation",
        "tag_prefix": "gpui-v",
        "asset": "dictation-gpui"
      },
      "settings_file": "dictation-config.json",
      "settings": [
        {
          "key": "hotkey",
          "label": "Хоткей",
          "kind": {
            "type": "text"
          },
          "value": "Ctrl+Shift+;",
          "hint": "Нажал — говорю, нажал ещё раз — готово"
        },
        {
          "key": "providerEnabled",
          "label": "Диктовка включена",
          "kind": {
            "type": "toggle"
          },
          "value": true
        },
        {
          "key": "injectMode",
          "label": "Вставлять текст автоматически",
          "kind": {
            "type": "switch",
            "on": "auto_paste",
            "off": "clipboard_only"
          },
          "value": "auto_paste",
          "hint": "Выключено — текст остаётся в буфере обмена"
        },
        {
          "key": "duckAudioDuringRecording",
          "label": "Приглушать звук при записи",
          "kind": {
            "type": "toggle"
          },
          "value": false
        },
