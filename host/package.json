{
  "name": "@kosmos/desktop-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@makekosmos/ark": "0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.9.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "playwright": "1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vite-plugin-electron": "1.0.0-beta.2"
  },
  "packageManager": "pnpm@12.4.1",
  "build": {
    "appId": "com.kosmos.package-host",
    "productName": "Kosmos Package Host",
    "icon": "../desktop/build/icon.ico",
    "extraResources": [
      {
        "from": "../desktop/build/app-icons",
        "to": "app-icons"
      }
    ],
    "win": {
      "signExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
