# Normalize all text files to LF in the repo and working tree.
# Matches oxfmt expectations; makes line endings independent of core.autocrlf.
* text=auto eol=lf

# Windows batch scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary types — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.exe   binary
*.dll   binary
*.node  binary
*.db    binary
*.sqlite binary
*.sqlite3 binary
*.wasm  binary
