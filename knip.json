{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".agent/**",
    ".desloppify/**",
    ".tmp/**",
    "site/vite.config.ts",
    "incubator/akasha/vite.config.mjs",
    "incubator/akasha/src/global.d.ts",
    "incubator/arrancador/vite.config.mjs",
    "core/ark/packages/ark/src/generated/**",
    "node_modules/**",
    "release/**",
    "target/**",
    "**/dist/**",
    "**/dist-electron/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.spec.ts",
        "tests/**/*.test.ts",
        "tests/**/*.bench.ts",
        "scripts/ark-inspect.mjs",
        "scripts/fix-mojibake.mjs",
        "scripts/merge-swap.mjs",
        "scripts/run-dictation-groq-smoke.mjs",
        "site/src/main.ts"
      ]
    },
    "platform/desktop": {
      "entry": [
        "electron/main.ts",
        "build/afterPack.cjs",
        "electron/preload.ts",
        "electron/extension-preload.ts",
        "vite.config.mjs",
        "vite.extensions.config.mjs",
        "src/main.ts",
        "src/styles.css",
        "e2e/**/*.spec.ts",
        "electron/**/*.test.ts",
        "src/**/*.test.ts"
      ],
      "project": ["electron/**/*.ts"],
      "ignoreDependencies": ["@cosmos.gl/graph", "@phosphor-icons/vue"]
    },
    "incubator/akasha": {
      "ignoreDependencies": ["@fontsource/source-serif-4", "@vitejs/plugin-vue"]
    },
    "incubator/arrancador": {
      "ignoreDependencies": ["@tailwindcss/vite"]
    },
    "products/delphi": {
      "entry": ["tests/**/*.spec.ts", "tests/**/*.test.ts", "tests/**/*.bench.ts"]
    }
  }
}
