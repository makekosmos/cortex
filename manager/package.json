{
  "name": "@kosmos/engine-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:run": "node scripts/dev-run.mjs run",
    "dev:list": "node scripts/dev-run.mjs list",
    "dev:stop": "node scripts/dev-run.mjs stop",
    "dev:reset": "node scripts/dev-run.mjs reset",
    "dev:diagnostics": "node scripts/dev-run.mjs diagnostics",
    "test:dev-run": "node --test scripts/dev-run.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "package:win": "node ../desktop/scripts/release-preflight.mjs --platform win && pnpm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "^3.6.0-beta.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.9.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vite-plugin-electron": "1.0.0-beta.2"
  },
  "packageManager": "pnpm@12.4.1",
  "build": {
    "appId": "com.kosmos.manager",
    "productName": "Kosmos Manager",
    "icon": "../desktop/build/icon.ico",
    "win": {
      "signExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
