{
  "name": "@kosmos/engine-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "package:win": "bun run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@kosmos/ark": "workspace:*",
    "@kosmos/visuals": "workspace:*",
    "vue": "^3.6.0-beta.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.9.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vite-plugin-electron": "1.0.0-beta.2"
  },
  "build": {
    "appId": "com.kosmos.manager",
    "productName": "Kosmos Manager",
    "icon": "../desktop/build/icon.ico",
    "win": {
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
