{
  "name": "@kosmos/shell",
  "private": true,
  "scripts": {
    "workspace": "node scripts/workspace.mjs",
    "prepare": "lefthook install",
    "check:plan": "node scripts/check-plan.mjs --mode worktree",
    "check:plan:ci": "node scripts/check-plan.mjs --mode ci",
    "check:affected": "node scripts/check-plan.mjs --mode worktree --run",
    "check:layout": "node scripts/check-layout.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "pnpm run typecheck:desktop && pnpm run typecheck:host && pnpm run typecheck:manager",
    "typecheck:desktop": "pnpm --dir desktop run typecheck",
    "typecheck:host": "pnpm --dir host run typecheck",
    "typecheck:manager": "pnpm --dir manager run typecheck",
    "rustfmt": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "node runtime/scripts/test-lib.mjs --workspace",
    "test:static": "pnpm run test:source-size && pnpm run test:format && pnpm run test:workspace && pnpm run test:package-manager && pnpm run test:release-bom && pnpm run test:package-contract && pnpm run test:desktop-contracts && pnpm run test:sidecar",
    "test": "pnpm run test:static && pnpm run test:backend",
    "check": "pnpm run check:layout && pnpm run check:source-size && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run rustfmt && pnpm run clippy && pnpm run test:static && pnpm run test:rust && pnpm --dir desktop run test:runtime-staging",
    "lint": "oxlint .",
    "test:source-size": "node --test scripts/check-source-size.test.mjs",
    "test:sidecar": "node --test desktop/scripts/ark-core-rpc.test.mjs desktop/scripts/ark-core-rpc-edge.test.mjs desktop/scripts/ark-core-rpc-recovery.test.mjs",
    "test:workspace": "node --test scripts/workspace.test.mjs scripts/workspace-bridge.test.mjs",
    "test:format": "node --test scripts/check-format.test.mjs",
    "test:release-bom": "node --test desktop/scripts/release-bom.test.mjs desktop/scripts/release-build-contract.test.mjs desktop/scripts/release-pipeline.test.mjs desktop/scripts/release-preflight.test.mjs desktop/scripts/first-party-release-contracts.test.mjs desktop/scripts/release-channel-local.test.mjs desktop/scripts/package-release.test.mjs",
    "test:package-contract": "node --experimental-transform-types --test --experimental-test-module-mocks --loader ./test-support/ts-loader.mjs desktop/electron/extension-manifest-validation.test.ts",
    "test:backend": "node runtime/scripts/test-lib.mjs",
    "test:desktop-contracts": "node --experimental-transform-types --test --experimental-test-module-mocks --loader ./test-support/ts-loader.mjs desktop/electron/instance.test.ts desktop/electron/focus-enforcement.test.ts desktop/build/installer-shortcut.test.mjs",
    "test:first-party-contracts": "pnpm --dir host run build && pnpm --dir host run e2e first-party-agenda-contract.spec.ts first-party-arcadia-contract.spec.ts first-party-dictation-contract.spec.ts first-party-memoria-contract.spec.ts first-party-memoria-import-crash.spec.ts first-party-ordo-contract.spec.ts --workers=1",
    "test:package-manager": "node --test scripts/package-manager-migration.test.mjs scripts/spawn-shell-contract.test.mjs manager/scripts/dev.test.mjs",
    "test:desktop-tooling": "node --test manager/scripts/dev-electron.test.mjs desktop/scripts/build-package-components.e2e.test.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "lefthook": "^2.1.10",
    "oxfmt": "latest",
    "oxlint": "1.80.0"
  },
  "packageManager": "pnpm@12.4.1",
  "kosmos": {
    "workspace": {
      "imago": {
        "repository": "makekosmos/imago",
        "commit": "19bc855317e47a54ddcf0f74d1d247921ac699bc",
        "package": {
          "name": "@makekosmos/visuals",
          "version": "0.1.4",
          "integrity": "git:19bc855317e47a54ddcf0f74d1d247921ac699bc"
        }
      },
      "arca-sdk": {
        "repository": "makekosmos/arca-sdk",
        "commit": "21c2f5e157944e3444d3c0604da5a0e041116077",
        "package": {
          "name": "@makekosmos/ark",
          "version": "0.1.1",
          "integrity": "git:21c2f5e157944e3444d3c0604da5a0e041116077"
        }
      }
    }
  }
}
