{
  "name": "kosmos",
  "private": true,
  "workspaces": [
    "shell",
    "extensions/*",
    "apps/*",
    "mobile/*",
    "services/*",
    "packages/*",
    "docs-site"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "ark:guard:writes": "node scripts/check-ark-write-boundaries.mjs",
    "ark:smoke": "node scripts/ark-smoke.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:dev": "bun run --cwd docs-site dev",
    "docs:build": "bun run docs:sync && bun run --cwd docs-site build",
    "docs:preview": "bun run --cwd docs-site preview",
    "docs:sync": "node scripts/sync-agents-docs.mjs",
    "docs:check": "node scripts/check-docs-freshness.mjs",
    "shell:typecheck": "bun run --cwd shell typecheck",
    "shell:build": "bun run --cwd shell build:js:shell",
    "ext:build": "bun run --cwd shell build:extension",
    "visual:regression": "playwright test tests/e2e/visual.spec.ts",
    "visual:launcher": "playwright test tests/e2e/visual.spec.ts --grep \"launcher\"",
    "visual:eden": "playwright test tests/e2e/visual.spec.ts --grep \"eden\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^42.2.0",
    "electron-playwright-helpers": "^2.1.0",
    "knip": "^6.14.1",
    "lefthook": "^2.1.8",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "playwright": "^1.60.0",
    "vue": "^3.6.0-beta.12",
    "vue-router": "^5.0.7"
  },
  "overrides": {
    "vite": "^8.0.3"
  },
  "packageManager": "bun@1.3.14"
}
