{
  "name": "kosmos",
  "private": true,
  "workspaces": [
    "shell",
    "extensions/*",
    "apps/*",
    "mobile/*",
    "services/*",
    "packages/*",
    "docs-site"
  ],
  "scripts": {
    "ark:guard:writes": "node scripts/check-ark-write-boundaries.mjs",
    "ark:smoke": "node scripts/ark-smoke.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:dev": "bun run --cwd docs-site dev",
    "docs:build": "bun run docs:sync && bun run --cwd docs-site build",
    "docs:preview": "bun run --cwd docs-site preview",
    "docs:sync": "node scripts/sync-agents-docs.mjs",
    "docs:check": "node scripts/check-docs-freshness.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^42.1.0",
    "electron-playwright-helpers": "^2.1.0",
    "knip": "^6.14.1",
    "oxfmt": "^0.43.0",
    "oxlint": "1.66.0",
    "playwright": "^1.60.0",
    "vue": "^3.6.0-beta.12",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "vite": "^8.0.3"
  },
  "packageManager": "bun@1.3.5"
}
