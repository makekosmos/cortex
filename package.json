{
  "name": "@kosmos/shell",
  "private": true,
  "scripts": {
    "workspace": "node scripts/workspace.mjs",
    "prepare": "lefthook install",
    "check:layout": "node scripts/check-layout.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "bun run typecheck:desktop && bun run typecheck:host && bun run typecheck:manager",
    "typecheck:desktop": "bun run --cwd desktop typecheck",
    "typecheck:host": "bun run --cwd host typecheck",
    "typecheck:manager": "bun run --cwd manager typecheck",
    "rustfmt": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "node runtime/scripts/test-lib.mjs --workspace",
    "test:static": "bun run test:source-size && bun run test:format && bun run test:workspace && bun run test:release-bom && bun run test:package-contract && bun run test:desktop-contracts",
    "test": "bun run test:static && bun run test:backend",
    "check": "bun run check:layout && bun run check:source-size && bun run lint && bun run format:check && bun run typecheck && bun run rustfmt && bun run clippy && bun run test:static && bun run test:rust && bun run --cwd desktop test:runtime-staging",
    "lint": "oxlint .",
    "test:source-size": "node --test scripts/check-source-size.test.mjs",
    "test:workspace": "node --test scripts/workspace.test.mjs scripts/workspace-bridge.test.mjs",
    "test:format": "node --test scripts/check-format.test.mjs",
    "test:release-bom": "node --test desktop/scripts/release-bom.test.mjs desktop/scripts/release-build-contract.test.mjs desktop/scripts/first-party-release-contracts.test.mjs desktop/scripts/release-channel-local.test.mjs desktop/scripts/package-release.test.mjs",
    "test:package-contract": "bun test desktop/electron/extension-manifest-validation.test.ts",
    "test:backend": "node runtime/scripts/test-lib.mjs",
    "test:desktop-contracts": "bun test desktop/electron/instance.test.ts desktop/electron/focus-enforcement.test.ts desktop/build/installer-shortcut.test.mjs",
    "test:first-party-contracts": "bun run --cwd host build && bun run --cwd host e2e first-party-agenda-contract.spec.ts first-party-arcadia-contract.spec.ts first-party-dictation-contract.spec.ts first-party-memoria-contract.spec.ts first-party-memoria-import-crash.spec.ts first-party-ordo-contract.spec.ts --workers=1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "lefthook": "^2.1.10",
    "oxfmt": "latest",
    "oxlint": "1.80.0"
  },
  "packageManager": "bun@1.3.14",
  "kosmos": {
    "workspace": {
      "imago": {
        "repository": "makekosmos/imago",
        "commit": "b1852cab9f8f08ae0b236b7759138d3117f720b8",
        "package": {
          "name": "@makekosmos/visuals",
          "version": "0.1.3",
          "integrity": "git:b1852cab9f8f08ae0b236b7759138d3117f720b8"
        }
      },
      "arca-sdk": {
        "repository": "makekosmos/arca-sdk",
        "commit": "21c2f5e157944e3444d3c0604da5a0e041116077",
        "package": {
          "name": "@makekosmos/ark",
          "version": "0.1.1",
          "integrity": "git:21c2f5e157944e3444d3c0604da5a0e041116077"
        }
      }
    }
  }
}
