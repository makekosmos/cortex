{
  "name": "@kosmos/shell",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "check:layout": "node scripts/check-layout.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "bun run typecheck:desktop && bun run typecheck:host && bun run typecheck:manager",
    "typecheck:desktop": "bun run --cwd desktop typecheck",
    "typecheck:host": "bun run --cwd host typecheck",
    "typecheck:manager": "bun run --cwd manager typecheck",
    "rustfmt": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace --all-targets",
    "test": "bun run test:source-size && bun run test:backend && bun run test:package-contract",
    "check": "bun run check:layout && bun run check:source-size && bun run lint && bun run format:check && bun run typecheck && bun run rustfmt && bun run clippy && bun run test && bun run --cwd desktop test:runtime-staging",
    "lint": "oxlint .",
    "test:source-size": "node --test scripts/check-source-size.test.mjs",
    "test:backend": "node runtime/scripts/test-lib.mjs",
    "test:package-contract": "bun test desktop/electron/extension-manifest-validation.test.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "lefthook": "^2.1.10",
    "oxfmt": "latest",
    "oxlint": "1.80.0"
  },
  "packageManager": "bun@1.3.14"
}
