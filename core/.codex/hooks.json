{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/orchestration-context.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex\\hooks\\orchestration-context.ps1')\"",
            "timeout": 10,
            "statusMessage": "Loading Kosmos model routing"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(explorer|worker|terra_worker|reviewer|task_.*|orchestrator)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/orchestration-context.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex\\hooks\\orchestration-context.ps1')\"",
            "timeout": 10,
            "statusMessage": "Loading Kosmos subagent routing"
          }
        ]
      }
    ]
  }
}
