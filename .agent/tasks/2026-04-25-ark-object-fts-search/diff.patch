+fn iso_date_days_ago(days_ago: i64) -> String {
+    (Utc::now().date_naive() - Duration::days(days_ago))
+        .format("%Y-%m-%d")
+        .to_string()
+}
+
+fn enumerate_dates(range_days: i64) -> Vec<String> {
+    (0..range_days)
+        .map(|index| iso_date_days_ago(range_days - index - 1))
+        .collect()
+}
