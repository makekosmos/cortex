+                platform: row.get(4)?,
+                device_name: row.get(5)?,
+                started_at: row.get(6)?,
+                ended_at: row.get(7)?,
+                foreground_ms: row.get::<_, Option<i64>>(8)?.unwrap_or(0),
+                idle_ms: row.get::<_, Option<i64>>(9)?.unwrap_or(0),
+                window_title: row.get(10)?,
+            })
+        })
+        .map_err(|e| e.to_string())?
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|e| e.to_string())?;
