{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@kosmos/ark": ["../../arca-sdk/src/index.ts"],
      "@kosmos/visuals": ["../../imago/index.ts"],
      "@kosmos/visuals/*": ["../../imago/*"],
      "@raycast/api": ["../../core/packages/raycast-api/src/index.ts"],
      "@raycast/api/*": ["../../core/packages/raycast-api/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "shared", "electron"],
  "exclude": ["**/*.test.ts"]
}
