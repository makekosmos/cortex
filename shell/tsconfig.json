{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@kosmos/ark": ["../packages/ark/src/index.ts"],
      "@kosmos/visuals": ["../packages/visuals/index.ts"],
      "@kosmos/visuals/*": ["../packages/visuals/*"],
      "@raycast/api": ["../packages/raycast-api/src/index.ts"],
      "@raycast/api/*": ["../packages/raycast-api/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "shared", "electron"]
}
