# shell/.env.local — per-worktree dev slot configuration.
# Скопируй в shell/.env.local (gitignored) и раскомментируй нужное.
#
# Подробнее: docs-site/concepts/instances.md

# Slot для этой dev-сессии. Дефолт (если файл отсутствует или строка
# закомментирована) — "dev". Чтобы запустить несколько dev-инстансов
# параллельно (multi-agent worktree), задай уникальный slug в каждом
# worktree: dev-a, dev-b, dev-eden, dev-issue-42 и т.п.
#
# Каждый slot получает изолированные:
#   Electron userData: %APPDATA%/Kepler-<slot>/
#   ARK data dir:      %APPDATA%/Kosmos-<slot>/  (ark.db, kepler.lock.json, ...)
#   product name:      Kepler [<slot>]           (tray tooltip)
#   hotkey:            disabled для dev-<x> и test-<x> (только prod=Alt+Space, dev=Alt+`)
#   autoupdater:       выключен везде кроме prod
#   HKCU autorun:      запрещён везде кроме prod
#
# Регулярка: ^(prod|dev|dev-[a-z0-9][a-z0-9-]*|test-[a-z0-9][a-z0-9-]*)$

# KEPLER_INSTANCE=dev-a
