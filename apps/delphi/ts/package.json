{
  "name": "delphi",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:ark": "cargo build --release --manifest-path ../../../packages/ark-core/rust/Cargo.toml --bin ark-core-rpc",
    "build:ark:dev": "cargo build --manifest-path ../../../packages/ark-core/rust/Cargo.toml --bin ark-core-rpc",
    "dev": "bun run build:ark:dev && vite --configLoader native",
    "build:js": "bun run build:ark && tsc && vite build --configLoader native",
    "build": "bun run build:js && electron-builder --win nsis",
    "package:dir": "bun run build:js && electron-builder --dir",
    "build:web": "BUILD_TARGET=web tsc && BUILD_TARGET=web vite build --configLoader native",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --configLoader native",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "oxlint -c .oxlintrc.json src/",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@kosmos/ark": "workspace:*",
    "@google/genai": "^1.42.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/qrcode": "^1.5.6",
    "bonjour-service": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.548.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.9.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.9.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^38.8.4",
    "electron-builder": "^26.8.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.57.0",
    "playwright": "^1.58.2",
    "oxfmt": "^0.7.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^8.0.3",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-electron": "1.0.0-beta.2",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.2"
  },
  "build": {
    "appId": "com.kazui.delphi",
    "productName": "Delphi",
    "npmRebuild": false,
    "afterPack": "./build/afterPack.cjs",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../../../packages/ark-core/rust/target/release/ark-core-rpc.exe",
        "to": "ark-core/ark-core-rpc.exe"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Delphi",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
