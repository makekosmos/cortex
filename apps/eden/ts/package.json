{
  "name": "eden",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cargo build --manifest-path heart/Cargo.toml && electron-vite dev --config electron.vite.config.ts",
    "build": "cargo build --release --manifest-path heart/Cargo.toml && tsc && electron-vite build --config electron.vite.config.ts",
    "lint": "oxlint . --ignore-pattern dist --ignore-pattern dist-electron --ignore-pattern release --ignore-pattern src/components/sidebar-anytype --ignore-pattern src-anytype --deny-warnings",
    "format": "oxfmt --check .",
    "package": "npm run build && electron-builder",
    "preview": "electron-vite preview --config electron.vite.config.ts",
    "test:e2e": "npm run build && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-mention": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/markdown": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "jsdom": "^28.1.0",
    "lowlight": "^3.3.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tippy.js": "^6.3.7",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^38.8.4",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "playwright": "^1.58.2",
    "typescript": "^5.2.2",
    "vite": "^7.3.1"
  },
  "main": "dist-electron/main.js"
}
