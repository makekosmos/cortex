{
  "name": "eden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cargo build --manifest-path heart/Cargo.toml && vite",
    "build": "cargo build --release --manifest-path heart/Cargo.toml && tsc && vite build",
    "lint": "oxlint . --ignore-pattern dist --ignore-pattern dist-electron --ignore-pattern release --ignore-pattern src/components/sidebar-anytype --ignore-pattern src-anytype --deny-warnings",
    "format": "oxfmt --check .",
    "package": "bun run build && electron-builder",
    "preview": "vite preview",
    "test:e2e": "bun run build && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-mention": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/markdown": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/suggestion": "^3.20.1",
    "@tiptap/vue-3": "^3.20.1",
    "lowlight": "^3.3.0",
    "pinia": "^3.0.4",
    "tippy.js": "^6.3.7",
    "uuid": "^13.0.0",
    "vue": "^3.6.0-beta.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^38.8.4",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.57.0",
    "playwright": "^1.58.2",
    "typescript": "~5.8.3",
    "vite": "^8.0.3",
    "vite-plugin-electron": "1.0.0-beta.2",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
