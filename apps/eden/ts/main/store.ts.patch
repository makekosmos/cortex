+export function createFolder(id: string, name: string): Folder {
+  if (!db) throw new Error("Database not initialized");
+  const folder: Folder = {
+    id,
+    name,
+    created_at: Date.now()
+  };
+  
+  const stmt = db.prepare('INSERT INTO folders (id, name, created_at) VALUES (@id, @name, @created_at)');
+  stmt.run(folder);
+  
+  if (entriesDir) {
+    const folderPath = path.join(entriesDir, id);
+    if (!fs.existsSync(folderPath)) {
+      fs.mkdirSync(folderPath, { recursive: true });
+    }
+  }
+  
+  return folder;
+}
+
+export function listFolders(): Folder[] {
+  if (!db) return [];
+  const stmt = db.prepare('SELECT * FROM folders ORDER BY name ASC');
+  return stmt.all() as Folder[];
+}
+
+export function moveEntryToFolder(entryId: string, folderId: string | null) {
+  if (!db) throw new Error("Database not initialized");
+  if (!entriesDir) throw new Error("Entries directory not initialized");
+  
+  const entry = loadEntry(entryId);
+  if (!entry) throw new Error("Entry not found");
+  
+  const oldFolderId = entry.folder_id;
+  
+  const stmt = db.prepare('UPDATE entries SET folder_id = ? WHERE id = ?');
+  stmt.run(folderId, entryId);
+  
+  // Move file on disk
+  const oldDir = oldFolderId ? path.join(entriesDir, oldFolderId) : entriesDir;
+  const newDir = folderId ? path.join(entriesDir, folderId) : entriesDir;
+  
+  const oldPath = path.join(oldDir, `${entryId}.md`);
+  const newPath = path.join(newDir, `${entryId}.md`);
+  
+  if (fs.existsSync(oldPath)) {
+    if (!fs.existsSync(newDir)) {
+      fs.mkdirSync(newDir, { recursive: true });
+    }
+    fs.renameSync(oldPath, newPath);
+  }
+}
