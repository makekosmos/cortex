{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vue-app/*": ["./src-vue/*"],
      "@kepler/visuals": ["../../packages/kepler-visuals/index.ts"],
      "@kepler/visuals/*": ["../../packages/kepler-visuals/*"]
    }
  },
  "include": [
    "src/electron.d.ts",
    "src-vue",
    "src-vue/**/*.d.ts",
    "src/lib/**/*.ts",
    "src/types/**/*.ts",
    "src/vite-env.d.ts",
    "src/vitest.d.ts"
  ]
}
