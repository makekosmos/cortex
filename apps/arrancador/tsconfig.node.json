{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@kepler/ark": ["../../packages/kepler-ark/src/index.ts"]
    }
  },
  "include": [
    "e2e/**/*.ts",
    "vite.config.mjs",
    "vitest.config.mjs",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "src/lib/native-rebuild.ts",
    "src/types/**/*.ts"
  ]
}
