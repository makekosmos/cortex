{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true
  },
  "include": [
    "electron/**/*.ts",
    "src/electron.d.ts",
    "src/types/**/*.ts"
  ],
