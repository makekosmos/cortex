{
  "id": "horologion",
  "name": "Horologion",
  "version": "0.1.5",
  "description": "Трекер времени и pomodoro",
  "keplerApiVersion": "^1.1.0",
  "kind": "vue",
  "icon": "icon.png",
  "entryHtml": "dist/index.html",
  "devPort": 5181,
  "width": 480,
  "height": 560,
  "minWidth": 320,
  "minHeight": 280,
  "keepAliveInBackground": true,
  "commands": [
    {
      "id": "open",
      "title": "Открыть Horologion",
      "subtitle": "Помодоро + Stopwatch",
      "kind": "app",
      "mode": "open"
    },
    {
      "id": "pomodoro:25",
      "title": "Помодоро 25 минут",
      "subtitle": "Horologion",
      "kind": "command",
      "mode": "action"
    },
    {
      "id": "pomodoro:50",
      "title": "Помодоро 50 минут",
      "subtitle": "Horologion",
      "kind": "command",
      "mode": "action"
    },
    {
      "id": "stopwatch:start",
      "title": "Запустить секундомер",
      "subtitle": "Horologion",
      "kind": "command",
      "mode": "action"
    }
  ],
  "tests": {
    "commands": ["horologion:pomodoro:25", "horologion:pomodoro:50", "horologion:stopwatch:start"],
    "smoke": {
      "objectType": "time_entry_obj",
      "sample": {
        "title": "contract-smoke-horologion"
      }
    }
  }
}
