{
  "id": "horologion",
  "name": "Horologion",
  "version": "0.1.2",
  "description": "Трекер времени и pomodoro",
  "author": "Kazui",
  "keplerApiVersion": "^1.0.0",
  "kind": "vue",
  "icon": "icon.png",
  "entryHtml": "dist/index.html",
  "devPort": 5181,
  "width": 480,
  "height": 560,
  "minWidth": 320,
  "minHeight": 280,
  "commands": [
    {
      "id": "open",
      "title": "Открыть Horologion",
      "subtitle": "Помодоро + Stopwatch",
      "kind": "app",
      "mode": "open"
    },
    {
      "id": "pomodoro",
      "title": "Помодоро",
      "subtitle": "Horologion",
      "route": "/?mode=pomodoro",
      "mode": "open"
    },
    {
      "id": "stopwatch",
      "title": "Секундомер",
      "subtitle": "Horologion",
      "route": "/?mode=stopwatch",
      "mode": "open"
    }
  ],
  "tests": {
    "commands": [
      "horologion:pomodoro:25",
      "horologion:pomodoro:50",
      "horologion:stopwatch:start"
    ],
    "smoke": {
      "objectType": "time_entry_obj",
      "sample": {
        "title": "contract-smoke-horologion"
      }
    }
  }
}
