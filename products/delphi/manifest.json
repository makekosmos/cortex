{
  "id": "delphi",
  "name": "Delphi",
  "version": "0.1.8",
  "description": "Менеджер задач",
  "keplerApiVersion": "^1.1.0",
  "kind": "vue",
  "icon": "icon.png",
  "entryHtml": "dist/index.html",
  "devPort": 9914,
  "width": 1100,
  "height": 720,
  "minWidth": 800,
  "minHeight": 500,
  "windowEffect": "acrylic",
  "permissions": ["objects.read", "objects.write", "commands.register", "commands.invoke"],
  "commands": [
    {
      "id": "open",
      "title": "Открыть Delphi",
      "subtitle": "Задачи",
      "kind": "app",
      "route": "/today",
      "mode": "open"
    },
    {
      "id": "inbox",
      "title": "Открыть входящие",
      "subtitle": "Delphi",
      "route": "/",
      "mode": "open"
    }
  ],
  "tests": {
    "commands": ["delphi:task:create", "delphi:task:today"],
    "smoke": {
      "objectType": "task_obj",
      "sample": {
        "title": "contract-smoke-delphi"
      }
    }
  }
}
